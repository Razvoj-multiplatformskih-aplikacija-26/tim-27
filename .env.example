# Razvojne vrednosti. Kopirajte u .env (cp .env.example .env) bez izmena; .env nije u git-u.
POSTGRES_USER=reboot
POSTGRES_PASSWORD=reboot
POSTGRES_DB=reboot
POSTGRES_PORT=5435
SERVER_PORT=8080
# Odakle pregledač sme da šalje izmene (backoffice u pregledaču: flutter run -d chrome --web-port 8081).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Koliko minuta važi prijava; za proveru isteka na odbrani može se staviti 1.
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false
# Lozinka svih demo naloga iz početnih podataka.
DEMO_PASSWORD=reboot-demo
JWT_SECRET=samo-za-razvoj-promeniti-0123456789abcdef
# Ključ spoljnog SMS servisa; za KT2 server koristi lažnu implementaciju koja samo piše u log.
SMS_API_KEY=sms-dev-0000000000
# Za server pokrenut van Docker-a (dart run apps/server/bin/server.dart).
DATABASE_URL=postgres://reboot:reboot@localhost:5435/reboot?sslmode=disable
